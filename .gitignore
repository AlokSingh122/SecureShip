.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.log
*.auto.tfvars
*.tfvars
!example.tfvars
override.tf
override.tf.json

# Scanner output
reports/*
!reports/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
